{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/match/**",
        "destination": "/match/[id].html"
      },
      {
        "source": "/team/**",
        "destination": "/team/[id].html"
      },
      {
        "source": "/player/**",
        "destination": "/player/[id].html"
      },
      {
        "source": "/league/**",
        "destination": "/league/[slug].html"
      },
      {
        "source": "/news/**",
        "destination": "/news/[id].html"
      },
      {
        "source": "/video/**",
        "destination": "/video/[id].html"
      }
    ],
    "headers": [
      {
        "source": "/_expo/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "react-native": {
    "messaging_android_notification_color": "@color/notification_icon_color",
    "messaging_android_notification_channel_id": "match-alerts"
  }
}
